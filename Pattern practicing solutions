# Write a program to print star right angled triangle.
n=int(input("Enter the number:"))
for i in range(1,n+1):
    for j in range(i):
        print("*",end="")
    print()

# write a program to print inverted star pattern right angled triangle.
n=int(input("Enter the number:"))
for i in range(n,0,-1):
    for j in range(i):
        print("*",end="")
    print()
    
